# Copy to .env.local (never commit it). Server-side only: do NOT prefix these with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
# Instagram Graph API (Business Discovery) - Instagram API with Facebook Login
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v25.0

# Supabase (browser-safe URL and anon/publishable key; never put a service-role key here).
# Find both in Project Settings > API. Never put the service_role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
